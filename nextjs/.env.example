# Infoplaza Platform API key — sign up at https://platform.infoplaza.com/
INFOPLAZA_API_KEY=

# Optional. Where the Platform is called; defaults to https://api.infoplaza.com/.
# Set it to point the examples at another environment. Every endpoint, the
# Transit Planner WebSocket included, is resolved under this base URL.
INFOPLAZA_API_URL=

# Optional. Signs the short-lived token that lets this app's own pages call its
# route handlers, which is what keeps those URLs from working elsewhere; see
# src/lib/frontend-token.ts. Left empty, the signing key is derived from the
# API key above, so the examples run with nothing else configured. Set it to
# any long random string (`openssl rand -hex 32`) to sign with a secret of its
# own — worth doing on a deployment, so that rotating one does not invalidate
# the other.
FRONTEND_TOKEN_SECRET=
